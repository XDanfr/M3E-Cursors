    "render": "node tools/render.mjs",
    "package": "node tools/package.mjs",
    "windows": "node tools/windows.mjs",
    "hyprcursor": "node tools/hyprcursor.mjs",
    "linux": "node tools/linux.mjs",
    "validate": "node tools/validate.mjs",
    "previews": "node tools/previews.mjs",
    "build": "npm run render && npm run package && npm run windows && npm run hyprcursor && npm run linux && npm run validate && npm run previews"
